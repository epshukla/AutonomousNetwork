# PostgreSQL + TimescaleDB
POSTGRES_USER=netops
POSTGRES_PASSWORD=netops
POSTGRES_DB=netops
DATABASE_URL=postgresql+asyncpg://netops:netops@localhost:5432/netops

# Redis
REDIS_URL=redis://localhost:6379/0

# Claude API
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Simulator
SIMULATOR_HOST=0.0.0.0
SIMULATOR_PORT=8000
TELEMETRY_INTERVAL_SECONDS=5

# Agent
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
SIMULATOR_URL=http://localhost:8000
AGENT_MODE=autonomous
OBSERVE_INTERVAL_SECONDS=10

# Logging
LOG_LEVEL=INFO
